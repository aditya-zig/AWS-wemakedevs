PORT=8787
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8787/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8787/api/auth/google/callback
VERIFIAI_STATE_SECRET=
VERIFIAI_WEB_URL=http://localhost:4173
VERIFIAI_SECURE_COOKIES=false
VERIFIAI_DATA_DIR=./data

# Agent harness. TrueForge is the migration target; set strands only for rollback while parity is being verified.
VERIFIAI_AGENT_HARNESS=trueforge
VERIFIAI_TRUEFORGE_BASE_URL=http://127.0.0.1:8790
# Model name must already be configured inside TrueForge Settings -> Models.
VERIFIAI_TRUEFORGE_MODEL=
# Optional OIDC ID token when TrueForge login is enabled. Local no-login mode leaves this blank.
VERIFIAI_TRUEFORGE_TOKEN=
VERIFIAI_TRUEFORGE_TIMEOUT_MS=180000
# Comma-separated names of connectors already registered in TrueForge Settings -> Connectors.
# Keep this empty until you intentionally scope which MCP servers VERIFAI workers may use.
VERIFIAI_TRUEFORGE_MCP_SERVERS=
# TrueForge tool-approval selectors. @destructive is the safe default.
VERIFIAI_TRUEFORGE_REQUIRE_APPROVAL_FOR_TOOLS=@destructive
# Enable only when a TrueForge sandbox provider is configured.
VERIFIAI_TRUEFORGE_SANDBOX=false

# Real agent model provider (legacy Strands rollback only)
VERIFIAI_MODEL_PROVIDER=openrouter
VERIFIAI_MODEL_ID=
VERIFIAI_MODEL_BASE_URL=
# Optional: when set, provider key is loaded from AWS Secrets Manager using the runtime IAM role.
VERIFIAI_MODEL_SECRET_ID=
VERIFIAI_MODEL_SECRET_FIELD=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
OLLAMA_API_KEY=
AWS_REGION=ap-south-1

# Local real-engine runtime
VERIFIAI_EXECUTION_MODE=local
VERIFIAI_LOCAL_WORKER_NETWORK=verifiai-agent-local
VERIFIAI_EXTERNAL_ENGINE_URL=http://external-engines:8789
VERIFIAI_BROWSER_USE_URL=http://browser-use:8792
VERIFIAI_CUA_URL=http://cua:8791

# Browser Use model (OpenAI-compatible endpoint)
VERIFIAI_BROWSER_USE_MODEL=gpt-5-mini
VERIFIAI_BROWSER_USE_MODEL_BASE_URL=https://openrouter.ai/api/v1
VERIFIAI_BROWSER_USE_MODEL_API_KEY=

# Cua computer agent model
VERIFIAI_CUA_MODEL=openai/gpt-5.4-mini
VERIFIAI_CUA_MODEL_API_BASE=
VERIFIAI_CUA_MODEL_API_KEY=
VERIFIAI_CUA_PROVIDER=docker
CUA_API_KEY=

# Strix
STRIX_LLM=
LLM_API_KEY=

# MiroFish
MIROFISH_LLM_API_KEY=
MIROFISH_LLM_BASE_URL=https://api.openai.com/v1
MIROFISH_LLM_MODEL_NAME=gpt-4o-mini
ZEP_API_KEY=
MIROFISH_MAX_ROUNDS=10
